@page "/projects/my"

<PageTitle>My Portfolio — VerifyGH</PageTitle>

<div style="display: flex; flex-direction: column; gap: 24px;">
    <div>
        <div class="vg-pill vg-pill-secondary" style="margin-bottom: 12px;">Student Portfolio</div>
        <h1 class="vg-gradient-text" style="font-size: 1.8rem; font-weight: 800; margin: 0 0 6px 0;">My Submissions & Portfolio</h1>
        <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">Track real-time review status, lecturer feedback, and public shareable portfolio.</p>
    </div>

    <!-- Linear-style Placeholder Box -->
    <div class="vg-placeholder">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(0, 230, 118, 0.1); border: 1px solid rgba(0, 230, 118, 0.25); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0 0 8px 0; color: #ffffff;">Student Projects Feed</h3>
        <p style="color: var(--text-secondary); max-width: 480px; margin: 0 auto 20px auto; font-size: 0.88rem; line-height: 1.5;">
            Responsive grid of project cards with status badges (Pending, Approved, Needs Revision) and live SignalR status listeners.
        </p>
        <span class="vg-pill">Assigned to: Frank Bless Kofi Tsetse (Frontend)</span>
    </div>
</div>
