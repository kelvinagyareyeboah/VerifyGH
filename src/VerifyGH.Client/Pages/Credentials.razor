@page "/credentials"

<PageTitle>Verified Badges — VerifyGH</PageTitle>

<div style="display: flex; flex-direction: column; gap: 24px;">
    <div>
        <div class="vg-pill vg-pill-secondary" style="margin-bottom: 12px;">Accreditation</div>
        <h1 class="vg-gradient-text" style="font-size: 1.8rem; font-weight: 800; margin: 0 0 6px 0;">Verified Badges & Credentials</h1>
        <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">Tamper-proof digital badges endorsed by accredited institutions.</p>
    </div>

    <!-- Linear-style Placeholder Box -->
    <div class="vg-placeholder">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(0, 230, 118, 0.1); border: 1px solid rgba(0, 230, 118, 0.25); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="7"></circle>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            </svg>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0 0 8px 0; color: #ffffff;">Credential Badges Display</h3>
        <p style="color: var(--text-secondary); max-width: 480px; margin: 0 auto 20px auto; font-size: 0.88rem; line-height: 1.5;">
            Verified badge cards with cryptographic hash signatures, shareable portfolio links, and QR code verification.
        </p>
        <span class="vg-pill">Assigned to: Opuni Frimpong Asante (Frontend)</span>
    </div>
</div>
