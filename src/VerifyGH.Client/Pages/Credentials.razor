@page "/credentials"

<PageTitle>Verified Badges — VerifyGH</PageTitle>

<div style="display:flex; flex-direction:column; gap:28px;" class="vg-animate-in">

    <!-- Header -->
    <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:12px;">
        <div>
            <span class="vg-pill vg-pill-secondary" style="margin-bottom:10px; display:inline-block;">Accreditation</span>
            <h1 class="vg-title-bold" style="font-size:1.75rem; margin:0 0 6px;">Verified Badges &amp; Credentials</h1>
            <p style="color:var(--text-secondary); margin:0; font-size:0.93rem;">
                Faculty-endorsed digital badges. Share your portfolio link or scan the QR code.
            </p>
        </div>
        <button type="button" class="vg-action-link primary-action" @onclick="CopyLink">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            @(LinkCopied ? "Copied!" : "Copy Portfolio Link")
        </button>
    </div>

    <!-- Public Share Banner -->
    <div style="background:var(--ghana-green-bg); border:1px solid var(--ghana-green-border); border-radius:var(--radius-md); padding:14px 18px; display:flex; align-items:center; gap:12px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ghana-green)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div>
            <span style="font-weight:700; color:var(--ghana-green); font-size:0.9rem;">Your portfolio is publicly verifiable.</span>
            <span style="color:var(--text-secondary); font-size:0.85rem; margin-left:6px;">
                Share: <span class="vg-mono" style="color:var(--text-primary);">verifygh.edu.gh/portfolio/kelvin-yeboah</span>
            </span>
        </div>
    </div>

    <!-- Badge Grid -->
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:16px;" class="vg-stagger">
        @foreach (var badge in Badges)
        {
            <div class="vg-card vg-card-animate" style="position:relative; overflow:hidden;">
                <!-- Accent stripe -->
                <div style="position:absolute; top:0; left:0; right:0; height:3px; background:@badge.Color;"></div>

                <div style="display:flex; flex-direction:column; gap:14px; padding-top:6px;">
                    <!-- Badge Icon + Title -->
                    <div style="display:flex; align-items:center; gap:14px;">
                        <div style="width:48px; height:48px; border-radius:var(--radius-md); background:@badge.BgColor; border:1px solid @badge.BorderColor; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            @((MarkupString)badge.IconSvg)
                        </div>
                        <div>
                            <div style="font-size:0.97rem; font-weight:700; color:var(--text-primary); letter-spacing:-0.01em; line-height:1.3;">@badge.ProjectTitle</div>
                            @if (badge.IsVerified)
                            {
                                <span class="vg-badge vg-badge-verified" style="margin-top:4px;">✓ Verified</span>
                            }
                            else
                            {
                                <span class="vg-badge vg-badge-pending" style="margin-top:4px;">Pending</span>
                            }
                        </div>
                    </div>

                    <!-- Meta info -->
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:0.8rem;">
                        <div>
                            <div class="vg-label">Endorsed by</div>
                            <div style="color:var(--text-primary); font-weight:600; margin-top:2px;">@badge.Supervisor</div>
                        </div>
                        <div>
                            <div class="vg-label">Institution</div>
                            <div style="color:var(--text-primary); font-weight:600; margin-top:2px;">@badge.Institution</div>
                        </div>
                        <div>
                            <div class="vg-label">Issued</div>
                            <div style="color:var(--text-primary); font-weight:600; margin-top:2px;">@badge.IssueDate</div>
                        </div>
                        <div>
                            <div class="vg-label">Credential ID</div>
                            <div class="vg-mono" style="color:var(--text-secondary); font-size:0.75rem; margin-top:2px;">@badge.CredentialId</div>
                        </div>
                    </div>

                    <!-- Skills -->
                    <div class="vg-skill-chips">
                        @foreach (var sk in badge.Skills)
                        {
                            <span class="vg-skill-chip">@sk</span>
                        }
                    </div>

                    <!-- Actions -->
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding-top:4px; border-top:1px solid var(--border-subtle);">
                        @if (!string.IsNullOrEmpty(badge.RepoUrl))
                        {
                            <a href="@badge.RepoUrl" target="_blank" class="vg-action-link">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                                Code
                            </a>
                        }
                        <!-- QR placeholder -->
                        <div style="margin-left:auto; display:flex; align-items:center; gap:6px; padding:5px 10px; border-radius:var(--radius-sm); border:1px solid var(--border-subtle); font-size:0.75rem; color:var(--text-muted); cursor:default;" title="QR code verification">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            QR
                        </div>
                        <button type="button" class="vg-action-link" @onclick="@(() => CopyCredentialLink(badge.CredentialId))" style="cursor:pointer;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                            Share
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool LinkCopied = false;

    private async Task CopyLink()
    {
        LinkCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        LinkCopied = false;
        StateHasChanged();
    }

    private void CopyCredentialLink(string id) { /* JS interop placeholder */ }

    private static readonly string ShieldIcon =
        "<svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='#059669' stroke-width='2' stroke-linecap='round'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/></svg>";

    private static readonly string StarIcon =
        "<svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='#d97706' stroke-width='2' stroke-linecap='round'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'/></svg>";

    private static readonly string BrainIcon =
        "<svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='#2563eb' stroke-width='2' stroke-linecap='round'><path d='M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z'/><path d='M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z'/></svg>";

    private List<BadgeItem> Badges = new()
    {
        new("Blockchain Transcript Verification",
            "Dr. Michael Soli", "University of Ghana",
            "Sept 10, 2025", "VGH-2025-001",
            "https://github.com/", new[]{"C#","Blazor","SQL"},
            true, "#059669", "var(--ghana-green-bg)", "var(--ghana-green-border)",
            ShieldIcon),

        new("AI Lecture Scheduler",
            "Dr. Isaac Wiafe", "University of Ghana",
            "Sept 18, 2025", "VGH-2025-002",
            "https://github.com/", new[]{"Python","ML","REST API"},
            false, "#d97706", "var(--ghana-gold-bg)", "var(--ghana-gold-border)",
            StarIcon),

        new("Campus Bus Tracker",
            "Dr. Ebenezer Owusu", "University of Ghana",
            "Aug 28, 2025", "VGH-2025-003",
            "https://github.com/", new[]{"React","TypeScript","SignalR"},
            true, "#2563eb", "var(--accent-blue-bg)", "var(--accent-blue-border)",
            BrainIcon),
    };

    private record BadgeItem(
        string ProjectTitle, string Supervisor, string Institution,
        string IssueDate, string CredentialId, string RepoUrl,
        string[] Skills, bool IsVerified,
        string Color, string BgColor, string BorderColor, string IconSvg);
}
