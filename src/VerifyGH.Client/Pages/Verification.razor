</style>

@code {
    private string _selectedTab = "All";
    private string _searchQuery = string.Empty;
    private bool   _loading     = true;

    private record TabDef(string Key, string Label);

    private readonly List<TabDef> _tabs = new()
    {
        new("All", "All Submissions"),
        new("Pending", "Awaiting Review"),
        new("Approved", "Verified by You"),
        new("NeedsRevision", "Revisions Requested")
    };

    protected override async Task OnInitializedAsync()
    {
        _ = VerifySvc.StartSignalRAsync(); // fire-and-forget so the page never waits on the hub
        try
        {
            var apiProjects = await VerifySvc.GetPendingSubmissionsAsync();
            if (apiProjects.Count > 0)
            {
                foreach (var p in apiProjects)
                {
                    var existing = _submissions.FirstOrDefault(s => s.Id == p.Id || s.Title.Equals(p.Title, StringComparison.OrdinalIgnoreCase));
                    if (existing is null)
                    {
                        _submissions.Insert(0, new SubmissionItem
                        {
                            Id          = p.Id,
                            StudentId   = p.StudentId,
                            StudentName = string.IsNullOrEmpty(p.StudentName) ? "Kelvin Agyare Yeboah" : p.StudentName,
                            Title       = p.Title,
                            Description = p.Description,
                            RepoUrl     = p.RepositoryUrl,
                            LiveDemoUrl = p.LiveDemoUrl,
                            Skills      = p.Skills,
                            Status      = p.Status,
                            SubmittedAt = p.CreatedAt,
                            VerifiedAt  = p.VerifiedAt,
                            Feedback    = p.LecturerFeedback
                        });
                    }
                    else
                    {
                        existing.Status = p.Status;
                        existing.Feedback = p.LecturerFeedback;
                        existing.VerifiedAt = p.VerifiedAt;
                    }
                }
            }
        }
        catch
        {
            // Gracefully keep fallback list
        }
        _loading = false;
    }

    private async Task EndorseProjectAsync(SubmissionItem item)
    {
        var dto = new VerifyGH.Shared.DTOs.VerifyProjectDto
        {
            ProjectId = item.Id,
            Status    = VerifyGH.Shared.Enums.VerificationStatus.Approved
        };
        var (result, error) = await VerifySvc.SubmitReviewAsync(dto);
        item.Status    = VerifyGH.Shared.Enums.VerificationStatus.Approved;
        item.VerifiedAt = DateTime.UtcNow;
        Snackbar.Add(error ?? $"Endorsed '{item.Title}'! Digital credential issued.", error is null ? Severity.Success : Severity.Error);
    }

    private async Task RequestRevisionAsync(SubmissionItem item)
    {
        var dto = new VerifyGH.Shared.DTOs.VerifyProjectDto
        {
            ProjectId = item.Id,
            Status    = VerifyGH.Shared.Enums.VerificationStatus.NeedsRevision,
            Feedback  = "Please update repository README with setup steps and verify automated unit tests."
        };
        var (result, error) = await VerifySvc.SubmitReviewAsync(dto);
        item.Status   = VerifyGH.Shared.Enums.VerificationStatus.NeedsRevision;
        item.Feedback = dto.Feedback;
        Snackbar.Add(error ?? $"Revision request sent to {item.StudentName}.", error is null ? Severity.Warning : Severity.Error);
    }

    public class SubmissionItem
    {
        public int Id { get; set; }
        public string StudentId { get; set; } = string.Empty;
        public string StudentName { get; set; } = string.Empty;
        public string Program { get; set; } = "BSc. Computer Science";
        public string Institution { get; set; } = "University of Ghana";
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string? RepoUrl { get; set; }
        public string? LiveDemoUrl { get; set; }
        public List<string> Skills { get; set; } = new();
        public VerificationStatus Status { get; set; }
        public DateTime SubmittedAt { get; set; }
        public DateTime? VerifiedAt { get; set; }
        public string? Feedback { get; set; }
    }

