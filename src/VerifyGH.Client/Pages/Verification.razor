            Title = "Fisheries Guard: AIS Vessel Tracking Anomaly Model",
            Description = "Spatial-temporal trajectory analyzer flagging unlicensed trawler incursions in Ghana's Exclusive Economic Zone.",
            RepoUrl = "https://github.com/student/vessel-tracker",
            Skills = new List<string> { "Python", "GIS", "PostGIS", "Docker" },
            Status = VerificationStatus.Approved,
            SubmittedAt = DateTime.UtcNow.AddDays(-25),
            VerifiedAt = DateTime.UtcNow.AddDays(-8)
        }
    };

    private int GetTabCount(string key) => key switch
    {
        "Pending"  => _submissions.Count(s => s.Status == VerificationStatus.Pending),
        "Reviewed" => _submissions.Count(s => s.Status is VerificationStatus.Approved or VerificationStatus.NeedsRevision or VerificationStatus.Rejected),
        _          => _submissions.Count
    };

    private List<SubmissionItem> FilteredSubmissions
    {
        get
        {
            var query = _submissions.AsEnumerable();

            if (_selectedTab == "Pending")
                query = query.Where(s => s.Status == VerificationStatus.Pending);
            else if (_selectedTab == "Reviewed")
                query = query.Where(s => s.Status is VerificationStatus.Approved or VerificationStatus.NeedsRevision or VerificationStatus.Rejected);

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(s => 
                    s.StudentName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.Skills.Any(sk => sk.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)));
            }

            return query.OrderByDescending(s => s.SubmittedAt).ToList();
        }
    }

    // ── Review Modal ─────────────────────────────────────────────────────────
    private bool _modalOpen;
    private SubmissionItem? _reviewing;
    private bool _approveSelected = true;
    private string _comment = string.Empty;

    private void OpenReviewModal(SubmissionItem item)
    {
        _reviewing = item;
        _approveSelected = true;
        _comment = string.Empty;
        _modalOpen = true;
    }

    private void CloseModal() => _modalOpen = false;

    private string _submitBtnStyle => _approveSelected
        ? "background: var(--accent-emerald); color: #080c14; text-transform: none; border-radius: 8px; font-weight: 700; font-size: 0.85rem; padding: 7px 20px;"
        : "background: var(--accent-rose); color: #ffffff; text-transform: none; border-radius: 8px; font-weight: 700; font-size: 0.85rem; padding: 7px 20px;";

    private string _approveLabelStyle => _approveSelected
        ? "flex: 1; display: flex; align-items: center; gap: 10px; cursor: pointer; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.4); border-radius: 9px; padding: 10px 14px;"
        : "flex: 1; display: flex; align-items: center; gap: 10px; cursor: pointer; background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); border-radius: 9px; padding: 10px 14px;";

    private string _rejectLabelStyle => !_approveSelected
        ? "flex: 1; display: flex; align-items: center; gap: 10px; cursor: pointer; background: rgba(244,63,94,0.1); border: 1px solid rgba(244,63,94,0.4); border-radius: 9px; padding: 10px 14px;"
        : "flex: 1; display: flex; align-items: center; gap: 10px; cursor: pointer; background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); border-radius: 9px; padding: 10px 14px;";

    private string _approveTextStyle => _approveSelected
        ? "font-size: 0.85rem; font-weight: 700; color: var(--accent-emerald)"
        : "font-size: 0.85rem; font-weight: 700; color: var(--text-secondary)";

    private string _rejectTextStyle => !_approveSelected
        ? "font-size: 0.85rem; font-weight: 700; color: var(--accent-rose)"
        : "font-size: 0.85rem; font-weight: 700; color: var(--text-secondary)";

    private string _commentPlaceholder => _approveSelected ? "Optional endorsement note..." : "Describe what needs to be revised...";

    private void SubmitReview()
    {
        if (_reviewing is null) return;

        if (_approveSelected)
        {
            _reviewing.Status = VerificationStatus.Approved;
            _reviewing.VerifiedAt = DateTime.UtcNow;
            _reviewing.Feedback = _comment;
            Snackbar.Add($"Endorsed '{_reviewing.Title}'! Credential issued.", Severity.Success);
        }
        else
        {
            _reviewing.Status = VerificationStatus.NeedsRevision;
            _reviewing.Feedback = _comment;
            Snackbar.Add($"Revision request sent to {_reviewing.StudentName}.", Severity.Warning);
        }

        _modalOpen = false;
    }

    private RenderFragment GetStatusPill(VerificationStatus status) => __builder =>
    {
        switch (status)
        {
            case VerificationStatus.Approved:
                <span style="font-size: 0.72rem; font-weight: 700; color: var(--accent-emerald); background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25); padding: 3px 9px; border-radius: 999px;">
                    ✓ VERIFIED
                </span>
                break;
            case VerificationStatus.NeedsRevision:
                <span style="font-size: 0.72rem; font-weight: 700; color: var(--accent-rose); background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.25); padding: 3px 9px; border-radius: 999px;">
                    REVISION REQUESTED
                </span>
                break;
            default:
                <span style="font-size: 0.72rem; font-weight: 700; color: var(--accent-gold); background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.25); padding: 3px 9px; border-radius: 999px;">
                    PENDING REVIEW
                </span>
                break;
        }
    };

    private string GetInitial(string name) => 
        string.IsNullOrWhiteSpace(name) ? "S" : name[0].ToString().ToUpper();
}
