@page "/verification"
@inject ISnackbar Snackbar
@inject UserSessionService Session
@inject VerificationService VerifySvc
@implements IDisposable

<PageTitle>Supervisor Review Queue — VerifyGH</PageTitle>

<div style="display: flex; flex-direction: column; gap: 24px;">
    
    <!-- Page Header -->
    <div class="queue-page-header">
        <div>
            <h1 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0 0 4px 0; letter-spacing: -0.02em;">
                Supervisor Review Queue
            </h1>
            <p style="color: #64748b; margin: 0; font-size: 0.9rem;">
                Review student capstone deliverables, inspect code repositories, and certify authentic Ghanaian talent.
            </p>
        </div>

        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <div class="live-signalr-chip @(VerifySvc.IsConnected ? "is-connected" : "is-connecting")" title="SignalR Real-Time WebSocket Channel">
                <span class="pulse-indicator"></span>
                <span>@(VerifySvc.IsConnected ? "Live Sync Active" : "Connecting Live Feed...")</span>
            </div>

            <button type="button" class="btn-refresh-icon" @onclick="LoadSubmissionsAsync" title="Refresh deliverables from database">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span>Refresh</span>
            </button>

            <div class="supervisor-pill">
                <div class="supervisor-avatar">@GetInitial(Session.CurrentSession.Name)</div>
                <div style="line-height: 1.25;">
                    <div style="font-size: 0.82rem; font-weight: 700; color: #0f172a;">@Session.CurrentSession.Name</div>
                    <div style="font-size: 0.72rem; color: #64748b;">@Session.CurrentSession.Organization</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Metric Cards -->
    <div class="verification-stats-grid">
        <div class="stat-card">
            <span class="stat-label" style="color: #d97706;">Awaiting Review</span>
            <span class="stat-value" style="color: #d97706;">
                @_submissions.Count(s => s.Status == VerificationStatus.Pending)
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-label" style="color: #059669;">Verified by You</span>
            <span class="stat-value" style="color: #059669;">
                @_submissions.Count(s => s.Status == VerificationStatus.Approved)
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-label" style="color: #dc2626;">Revisions Requested</span>
            <span class="stat-value" style="color: #dc2626;">
                @_submissions.Count(s => s.Status == VerificationStatus.NeedsRevision)
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-label">Total Students</span>
            <span class="stat-value">
                @_submissions.Select(s => s.StudentId).Distinct().Count()
            </span>
        </div>
    </div>

    <!-- Toolbar: Tabs & Search -->
    <div class="toolbar">
        <div class="filter-tabs">
            @foreach (var tab in _tabs)
            {
                var isSelected = _selectedTab == tab.Key;
                <button type="button" 
                        class="filter-tab @(isSelected ? "active" : "")"
                        @onclick="() => _selectedTab = tab.Key">
                    @tab.Label (@GetTabCount(tab.Key))
                </button>
            }
        </div>

        <div class="search-input-wrapper">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" placeholder="Filter by student or skill..."
                   @bind="_searchQuery" @bind:event="oninput"
                   class="search-input" />
        </div>
    </div>

    <!-- Submissions List -->
    @if (_loading)
    {
        <div class="empty-state">
            <div style="width: 32px; height: 32px; border: 3px solid #e2e8f0; border-top-color: #059669; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
            <p style="margin: 12px 0 0; font-size: 0.92rem; color: #64748b; font-weight: 500;">
                Loading deliverables from database...
            </p>
        </div>
    }
    else if (FilteredSubmissions.Count == 0)
    {
        <div class="empty-state">
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <p style="margin: 10px 0 0; font-size: 0.95rem; color: #0f172a; font-weight: 700;">
                No Submissions in @Session.CurrentSession.Name's Queue
            </p>
            <p style="margin: 4px 0 16px; font-size: 0.85rem; color: #64748b; max-width: 420px;">
                Student capstone deliverables assigned to @Session.CurrentSession.Name appear here automatically in real time.
            </p>
            <button type="button" class="btn-primary-green" @onclick="LoadSubmissionsAsync" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span>Check for Updates</span>
            </button>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 16px;">
            @foreach (var item in FilteredSubmissions)
            {
                <div class="submission-card">
                    <!-- Top Row: Student Profile & Status -->
                    <div class="submission-header-row">
                        
                        <!-- Student Identity -->
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div class="student-avatar">
                                @GetInitial(item.StudentName)
                            </div>
                            <div>
                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <span style="font-size: 0.98rem; font-weight: 700; color: #0f172a;">@item.StudentName</span>
                                    <span class="student-id-tag">ID: @item.StudentId</span>
                                </div>
                                <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">
                                    @item.Program — @item.Institution
                                </div>
                            </div>
                        </div>

                        <!-- Status Badge -->
                        <div>
                            @GetStatusPill(item.Status)
                        </div>
                    </div>

                    <!-- Project Details -->
                    <div class="project-details-box">
                        <h3 class="project-headline">@item.Title</h3>
                        <p class="project-desc">@item.Description</p>

                        <!-- Tech Skills -->
                        <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px;">
                            @foreach (var skill in item.Skills)
                            {
                                <span class="skill-pill">@skill</span>
                            }
                        </div>

                        <!-- Links -->
                        <div class="deliverables-row">
                            @if (!string.IsNullOrEmpty(item.RepoUrl))
                            {
                                <a href="@item.RepoUrl" target="_blank" class="deliverable-link">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                                    </svg>
                                    <span>GitHub Repository</span>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(item.LiveDemoUrl))
                            {
                                <a href="@item.LiveDemoUrl" target="_blank" class="deliverable-link" style="color: #0284c7;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="2" y1="12" x2="22" y2="12"/>
                                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                    </svg>
                                    <span>Live Demonstration</span>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Bottom Action / Feedback Row -->
                    @if (item.Status == VerificationStatus.Approved)
                    {
                        <div class="status-approved-box">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                <span>Verified &amp; Endorsed by @(Session.CurrentSession.Name) on @(item.VerifiedAt?.ToString("MMM dd, yyyy") ?? DateTime.Now.ToString("MMM dd, yyyy"))</span>
                            </div>
                            <span style="font-size: 0.75rem; font-weight: 700; white-space: nowrap;">Credential Active</span>
                        </div>
                    }
                    else if (item.Status == VerificationStatus.NeedsRevision)
                    {
                        <div class="revision-note-box">
                            <div style="font-size: 0.78rem; font-weight: 700; color: #dc2626; margin-bottom: 2px;">Your Revision Note to Student:</div>
                            <div style="font-size: 0.84rem; color: #7f1d1d; font-style: italic;">"@item.Feedback"</div>
                        </div>
                    }
                    else
                    {
                        <div class="card-action-buttons">
                            <button type="button" class="btn-secondary" @onclick="() => RequestRevisionAsync(item)">
                                Request Changes
                            </button>
                            <button type="button" class="btn-primary-green" @onclick="() => EndorseProjectAsync(item)">
                                ✓ Endorse &amp; Certify
                            </button>
                        </div>
                    }

                </div>
            }
        </div>
    }

</div>

<style>
    .live-signalr-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        transition: all 0.2s ease;
    }
    .live-signalr-chip.is-connected {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }
    .live-signalr-chip.is-connecting {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }
    .pulse-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        animation: pulseDot 1.8s infinite;
    }
    @@keyframes pulseDot {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    .btn-refresh-icon {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        color: #334155;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-refresh-icon:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a;
    }

    .queue-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 16px;
    }

    .supervisor-pill {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        padding: 6px 14px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .supervisor-avatar {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #e0f2fe;
        color: #0369a1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.84rem;
        flex-shrink: 0;
    }

    .verification-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 14px;
    }

    .stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .stat-label {
        font-size: 0.76rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .stat-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .filter-tabs {
        display: inline-flex;
        background: #f1f5f9;
        padding: 3px;
        border-radius: 8px;
        gap: 2px;
    }
    .filter-tab {
        border: none;
