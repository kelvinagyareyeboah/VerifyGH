    .project-details-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
    }

    .project-headline {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
