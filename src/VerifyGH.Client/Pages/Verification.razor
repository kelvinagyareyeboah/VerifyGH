</style>

@code {
    private string _selectedTab = "All";
    private string _searchQuery = string.Empty;
    private bool   _loading     = true;

    private record TabDef(string Key, string Label);

    private readonly List<TabDef> _tabs = new()
    {
        new("All", "All Submissions"),
        new("Pending", "Awaiting Review"),
        new("Approved", "Verified by You"),
        new("NeedsRevision", "Revisions Requested")
    };

    protected override async Task OnInitializedAsync()
    {
        VerifySvc.OnNewProjectSubmitted     += HandleLiveNewProject;
        VerifySvc.OnProjectStatusUpdated    += HandleLiveStatusUpdated;
        VerifySvc.OnProjectDeleted          += HandleLiveProjectDeleted;
        VerifySvc.OnConnectionStatusChanged += HandleConnectionStatusChanged;
        Session.OnChange                    += HandleSessionChanged;

        _ = VerifySvc.StartSignalRAsync();

        await LoadSubmissionsAsync();
    }

    private async Task LoadSubmissionsAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var apiProjects = await VerifySvc.GetPendingSubmissionsAsync(Session.CurrentSession.Email);
            _submissions = apiProjects.Select(p => new SubmissionItem
            {
                Id          = p.Id,
                StudentId   = string.IsNullOrEmpty(p.StudentId) ? "22159683" : p.StudentId,
                StudentName = string.IsNullOrEmpty(p.StudentName) ? "Kelvin Agyare Yeboah" : p.StudentName,
                Program     = "BSc. Computer Science",
                Institution = string.IsNullOrEmpty(p.Institution) ? "University of Ghana" : p.Institution,
                Title       = p.Title,
                Description = p.Description,
                RepoUrl     = p.RepositoryUrl,
                LiveDemoUrl = p.LiveDemoUrl,
                Skills      = p.Skills ?? new List<string>(),
                Status      = p.Status,
                SubmittedAt = p.CreatedAt,
                VerifiedAt  = p.VerifiedAt,
                Feedback    = p.LecturerFeedback
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Verification] Error loading submissions: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(LoadSubmissionsAsync);
    }

    private void HandleConnectionStatusChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleLiveNewProject(ProjectDto p)
    {
        InvokeAsync(() =>
        {
            var existing = _submissions.FirstOrDefault(s => s.Id == p.Id);
            if (existing is null)
            {
                _submissions.Insert(0, new SubmissionItem
                {
                    Id          = p.Id,
                    StudentId   = string.IsNullOrEmpty(p.StudentId) ? "22159683" : p.StudentId,
                    StudentName = string.IsNullOrEmpty(p.StudentName) ? "Kelvin Agyare Yeboah" : p.StudentName,
                    Program     = "BSc. Computer Science",
                    Institution = string.IsNullOrEmpty(p.Institution) ? "University of Ghana" : p.Institution,
                    Title       = p.Title,
                    Description = p.Description,
                    RepoUrl     = p.RepositoryUrl,
                    LiveDemoUrl = p.LiveDemoUrl,
                    Skills      = p.Skills ?? new List<string>(),
                    Status      = p.Status,
                    SubmittedAt = p.CreatedAt,
                    VerifiedAt  = p.VerifiedAt,
                    Feedback    = p.LecturerFeedback
                });
                Snackbar.Add($"⚡ Real-Time Deliverable: '{p.Title}' added to your queue!", Severity.Info);
                StateHasChanged();
            }
        });
    }

    private void HandleLiveStatusUpdated(int projectId, string status, string? feedback)
    {
        InvokeAsync(() =>
        {
            var item = _submissions.FirstOrDefault(s => s.Id == projectId);
            if (item is not null && Enum.TryParse<VerificationStatus>(status, true, out var parsed))
            {
                item.Status = parsed;
                item.Feedback = feedback;
                if (parsed == VerificationStatus.Approved) item.VerifiedAt = DateTime.UtcNow;
                StateHasChanged();
            }
        });
    }

    private void HandleLiveProjectDeleted(int projectId)
    {
        InvokeAsync(() =>
        {
            var item = _submissions.FirstOrDefault(s => s.Id == projectId);
            if (item is not null)
            {
                _submissions.Remove(item);
                Snackbar.Add($"Project #{projectId} was withdrawn.", Severity.Normal);
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        VerifySvc.OnNewProjectSubmitted     -= HandleLiveNewProject;
        VerifySvc.OnProjectStatusUpdated    -= HandleLiveStatusUpdated;
        VerifySvc.OnProjectDeleted          -= HandleLiveProjectDeleted;
        VerifySvc.OnConnectionStatusChanged -= HandleConnectionStatusChanged;
        Session.OnChange                    -= HandleSessionChanged;
    }

    private async Task EndorseProjectAsync(SubmissionItem item)
    {
        var dto = new VerifyGH.Shared.DTOs.VerifyProjectDto
        {
            ProjectId = item.Id,
            Status    = VerifyGH.Shared.Enums.VerificationStatus.Approved
        };
        var (result, error) = await VerifySvc.SubmitReviewAsync(dto);
        item.Status    = VerifyGH.Shared.Enums.VerificationStatus.Approved;
        item.VerifiedAt = DateTime.UtcNow;
        Snackbar.Add(error ?? $"Endorsed '{item.Title}'! Digital credential issued.", error is null ? Severity.Success : Severity.Error);
    }

    private async Task RequestRevisionAsync(SubmissionItem item)
    {
        var dto = new VerifyGH.Shared.DTOs.VerifyProjectDto
        {
            ProjectId = item.Id,
            Status    = VerifyGH.Shared.Enums.VerificationStatus.NeedsRevision,
            Feedback  = "Please update repository README with setup steps and verify automated unit tests."
        };
        var (result, error) = await VerifySvc.SubmitReviewAsync(dto);
        item.Status   = VerifyGH.Shared.Enums.VerificationStatus.NeedsRevision;
        item.Feedback = dto.Feedback;
        Snackbar.Add(error ?? $"Revision request sent to {item.StudentName}.", error is null ? Severity.Warning : Severity.Error);
    }

    public class SubmissionItem
    {
        public int Id { get; set; }
        public string StudentId { get; set; } = string.Empty;
        public string StudentName { get; set; } = string.Empty;
        public string Program { get; set; } = "BSc. Computer Science";
        public string Institution { get; set; } = "University of Ghana";
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string? RepoUrl { get; set; }
        public string? LiveDemoUrl { get; set; }
        public List<string> Skills { get; set; } = new();
        public VerificationStatus Status { get; set; }
        public DateTime SubmittedAt { get; set; }
        public DateTime? VerifiedAt { get; set; }
        public string? Feedback { get; set; }
    }

    private List<SubmissionItem> _submissions = new();

    private int GetTabCount(string key) => key switch
    {
        "Pending" => _submissions.Count(s => s.Status == VerificationStatus.Pending),
        "Approved" => _submissions.Count(s => s.Status == VerificationStatus.Approved),
        "NeedsRevision" => _submissions.Count(s => s.Status == VerificationStatus.NeedsRevision),
        _ => _submissions.Count
    };

    private List<SubmissionItem> FilteredSubmissions
    {
        get
        {
            var query = _submissions.AsEnumerable();

            if (_selectedTab == "Pending")
                query = query.Where(s => s.Status == VerificationStatus.Pending);
            else if (_selectedTab == "Approved")
                query = query.Where(s => s.Status == VerificationStatus.Approved);
            else if (_selectedTab == "NeedsRevision")
                query = query.Where(s => s.Status == VerificationStatus.NeedsRevision);

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(s => 
                    s.StudentName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.Skills.Any(sk => sk.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)));
            }

            return query.OrderByDescending(s => s.SubmittedAt).ToList();
        }
    }

    private void EndorseProject(SubmissionItem item)
    {
        item.Status = VerificationStatus.Approved;
        item.VerifiedAt = DateTime.UtcNow;
        Snackbar.Add($"Endorsed '{item.Title}' by {item.StudentName}! Verified credential issued.", Severity.Success);
    }

    private void RequestRevision(SubmissionItem item)
    {
        item.Status = VerificationStatus.NeedsRevision;
        item.Feedback = "Please update repository README with setup steps and verify automated unit tests.";
        Snackbar.Add($"Revision request sent to {item.StudentName}.", Severity.Warning);
    }

    private RenderFragment GetStatusPill(VerificationStatus status) => __builder =>
    {
        switch (status)
        {
            case VerificationStatus.Approved:
                <span style="font-size: 0.72rem; font-weight: 700; color: #15803d; background: #dcfce7; padding: 3px 9px; border-radius: 999px;">
                    ✓ VERIFIED
                </span>
                break;
            case VerificationStatus.NeedsRevision:
                <span style="font-size: 0.72rem; font-weight: 700; color: #b91c1c; background: #fee2e2; padding: 3px 9px; border-radius: 999px;">
                    REVISION REQUESTED
                </span>
                break;
            default:
                <span style="font-size: 0.72rem; font-weight: 700; color: #b45309; background: #fef3c7; padding: 3px 9px; border-radius: 999px;">
                    PENDING REVIEW
                </span>
                break;
        }
    };

    private string GetInitial(string name) => 
        string.IsNullOrWhiteSpace(name) ? "S" : name[0].ToString().ToUpper();
}
