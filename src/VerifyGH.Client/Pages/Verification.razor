    private int GetTabCount(string key) => key switch
    {
        "Pending" => _submissions.Count(s => s.Status == VerificationStatus.Pending),
        "Approved" => _submissions.Count(s => s.Status == VerificationStatus.Approved),
        "NeedsRevision" => _submissions.Count(s => s.Status == VerificationStatus.NeedsRevision),
        _ => _submissions.Count
    };

    private List<SubmissionItem> FilteredSubmissions
    {
        get
        {
            var query = _submissions.AsEnumerable();

            if (_selectedTab == "Pending")
                query = query.Where(s => s.Status == VerificationStatus.Pending);
            else if (_selectedTab == "Approved")
                query = query.Where(s => s.Status == VerificationStatus.Approved);
            else if (_selectedTab == "NeedsRevision")
                query = query.Where(s => s.Status == VerificationStatus.NeedsRevision);

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(s => 
                    s.StudentName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.Skills.Any(sk => sk.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)));
            }

            return query.OrderByDescending(s => s.SubmittedAt).ToList();
        }
    }

    private void EndorseProject(SubmissionItem item)
    {
        item.Status = VerificationStatus.Approved;
        item.VerifiedAt = DateTime.UtcNow;
        Snackbar.Add($"Endorsed '{item.Title}' by {item.StudentName}! Verified credential issued.", Severity.Success);
    }

    private void RequestRevision(SubmissionItem item)
    {
        item.Status = VerificationStatus.NeedsRevision;
        item.Feedback = "Please update repository README with setup steps and verify automated unit tests.";
        Snackbar.Add($"Revision request sent to {item.StudentName}.", Severity.Warning);
    }

    private RenderFragment GetStatusPill(VerificationStatus status) => __builder =>
    {
        switch (status)
        {
            case VerificationStatus.Approved:
                <span style="font-size: 0.72rem; font-weight: 700; color: #15803d; background: #dcfce7; padding: 3px 9px; border-radius: 999px;">
                    ✓ VERIFIED
                </span>
                break;
            case VerificationStatus.NeedsRevision:
                <span style="font-size: 0.72rem; font-weight: 700; color: #b91c1c; background: #fee2e2; padding: 3px 9px; border-radius: 999px;">
                    REVISION REQUESTED
                </span>
                break;
            default:
                <span style="font-size: 0.72rem; font-weight: 700; color: #b45309; background: #fef3c7; padding: 3px 9px; border-radius: 999px;">
                    PENDING REVIEW
                </span>
                break;
        }
    };

    private string GetInitial(string name) => 
        string.IsNullOrWhiteSpace(name) ? "S" : name[0].ToString().ToUpper();
}
