@page "/verification"

<PageTitle>Lecturer Review Queue — VerifyGH</PageTitle>

<div style="display: flex; flex-direction: column; gap: 24px;">
    <div>
        <div class="vg-pill" style="background: rgba(0, 229, 255, 0.12); color: var(--accent-cyan); border-color: rgba(0, 229, 255, 0.25); margin-bottom: 12px;">Lecturer Portal</div>
        <h1 class="vg-gradient-text" style="font-size: 1.8rem; font-weight: 800; margin: 0 0 6px 0;">Verification Review Queue</h1>
        <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">Review student submissions, validate deliverables, provide feedback, and issue badges.</p>
    </div>

    <!-- Linear-style Placeholder Box -->
    <div class="vg-placeholder">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(0, 229, 255, 0.1); border: 1px solid rgba(0, 229, 255, 0.25); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0 0 8px 0; color: #ffffff;">Supervisor Review Queue</h3>
        <p style="color: var(--text-secondary); max-width: 480px; margin: 0 auto 20px auto; font-size: 0.88rem; line-height: 1.5;">
            Tabbed table of pending submissions, one-click approve/reject modal, and lecturer feedback comments broadcasted via SignalR.
        </p>
        <span class="vg-pill" style="background: rgba(0, 229, 255, 0.12); color: var(--accent-cyan); border-color: rgba(0, 229, 255, 0.25);">Assigned to: Tieku Justice (Frontend)</span>
    </div>
</div>
