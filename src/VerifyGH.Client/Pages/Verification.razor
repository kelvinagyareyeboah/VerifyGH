@page "/verification"
@inject ISnackbar Snackbar
@inject UserSessionService Session

<PageTitle>Supervisor Review Queue — VerifyGH</PageTitle>

<div style="max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px;">
    
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--accent); background: rgba(99, 102, 241, 0.12); padding: 4px 10px; border-radius: 6px; margin-bottom: 8px;">
                Faculty Portal
            </div>
            <h1 style="font-size: 1.8rem; font-weight: 800; color: #ffffff; margin: 0 0 4px 0; letter-spacing: -0.02em;">
                Supervisor Review Queue
            </h1>
            <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">
                Review student capstone deliverables, inspect code repositories, and certify authentic Ghanaian talent.
            </p>
        </div>

        <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); padding: 8px 14px; border-radius: 10px; display: flex; align-items: center; gap: 10px;">
            <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(99, 102, 241, 0.2); color: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem;">
                MS
            </div>
            <div style="line-height: 1.25;">
                <div style="font-size: 0.82rem; font-weight: 700; color: #ffffff;">Dr. Michael Soli</div>
                <div style="font-size: 0.72rem; color: var(--text-muted);">Dept. of Computer Science, UG</div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Metric Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px;">
        <div class="vg-card" style="padding: 16px 20px; border-left: 3px solid var(--accent-gold);">
            <div style="font-size: 0.75rem; color: var(--accent-gold); font-weight: 700; text-transform: uppercase;">Awaiting Your Review</div>
            <div style="font-size: 1.8rem; font-weight: 800; color: #ffffff; margin-top: 2px;">
                @_submissions.Count(s => s.Status == VerificationStatus.Pending)
            </div>
        </div>

        <div class="vg-card" style="padding: 16px 20px; border-left: 3px solid var(--accent-emerald);">
            <div style="font-size: 0.75rem; color: var(--accent-emerald); font-weight: 700; text-transform: uppercase;">Verified by You</div>
            <div style="font-size: 1.8rem; font-weight: 800; color: #ffffff; margin-top: 2px;">
                @_submissions.Count(s => s.Status == VerificationStatus.Approved)
            </div>
        </div>

        <div class="vg-card" style="padding: 16px 20px; border-left: 3px solid var(--accent-rose);">
            <div style="font-size: 0.75rem; color: var(--accent-rose); font-weight: 700; text-transform: uppercase;">Revisions Requested</div>
            <div style="font-size: 1.8rem; font-weight: 800; color: #ffffff; margin-top: 2px;">
                @_submissions.Count(s => s.Status == VerificationStatus.NeedsRevision)
            </div>
        </div>

        <div class="vg-card" style="padding: 16px 20px; border-left: 3px solid var(--accent);">
            <div style="font-size: 0.75rem; color: var(--accent); font-weight: 700; text-transform: uppercase;">Supervised Students</div>
            <div style="font-size: 1.8rem; font-weight: 800; color: #ffffff; margin-top: 2px;">
                @_submissions.Select(s => s.StudentId).Distinct().Count()
            </div>
        </div>
    </div>

    <!-- Filter Tabs & Search -->
    <div class="vg-card" style="padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            @foreach (var tab in _tabs)
            {
                var isSelected = _selectedTab == tab.Key;
                <button type="button" 
                        @onclick="() => _selectedTab = tab.Key"
                        style="background: @(isSelected ? "var(--accent)" : "rgba(255,255,255,0.04)");
                               color: @(isSelected ? "#ffffff" : "var(--text-secondary)");
                               font-weight: @(isSelected ? "700" : "500");
                               border: 1px solid @(isSelected ? "var(--accent)" : "var(--border-subtle)");
                               padding: 6px 14px;
                               border-radius: 8px;
                               font-size: 0.82rem;
                               cursor: pointer;
                               transition: all 0.15s ease;">
                    @tab.Label (@GetTabCount(tab.Key))
                </button>
            }
        </div>

        <div style="width: 260px;">
            <MudTextField @bind-Value="_searchQuery"
                          Placeholder="Filter by student or skill..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="background: rgba(255,255,255,0.03);" />
        </div>
    </div>

    <!-- Submissions List -->
    @if (FilteredSubmissions.Count == 0)
    {
        <div class="vg-placeholder" style="padding: 40px; text-align: center;">
            <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem;">
                No submissions found matching the selected filter.
            </p>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 16px;">
            @foreach (var item in FilteredSubmissions)
            {
                <div class="vg-card" style="padding: 22px; border-radius: 12px; display: flex; flex-direction: column; gap: 16px;">
                    
                    <!-- Top Row: Student Profile & Status -->
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
                        
                        <!-- Student Identity -->
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3); color: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.95rem;">
                                @GetInitial(item.StudentName)
                            </div>
                            <div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 1rem; font-weight: 800; color: #ffffff;">@item.StudentName</span>
                                    <span style="font-size: 0.72rem; font-family: 'JetBrains Mono', monospace; color: var(--text-muted); background: rgba(255,255,255,0.04); padding: 2px 6px; border-radius: 4px;">
                                        ID: @item.StudentId
                                    </span>
                                </div>
                                <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 2px;">
                                    @item.Program — @item.Institution
                                </div>
                            </div>
                        </div>

                        <!-- Status Badge -->
                        <div>
                            @GetStatusPill(item.Status)
                        </div>

                    </div>

                    <!-- Middle: Project Details -->
                    <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-subtle); border-radius: 10px; padding: 14px;">
                        <div style="font-size: 1.1rem; font-weight: 700; color: #ffffff; margin-bottom: 6px;">
                            @item.Title
                        </div>
                        <p style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.5; margin: 0 0 12px 0;">
                            @item.Description
                        </p>

                        <!-- Tech Skills -->
                        <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px;">
                            @foreach (var skill in item.Skills)
                            {
                                <span style="font-size: 0.72rem; background: rgba(99, 102, 241, 0.12); color: var(--accent); border: 1px solid rgba(99, 102, 241, 0.25); padding: 2px 8px; border-radius: 5px; font-weight: 600;">
                                    @skill
                                </span>
                            }
                        </div>

                        <!-- Links -->
                        <div style="display: flex; gap: 14px; font-size: 0.8rem; border-top: 1px solid var(--border-subtle); padding-top: 10px;">
                            @if (!string.IsNullOrEmpty(item.RepoUrl))
                            {
                                <a href="@item.RepoUrl" target="_blank" style="color: #ffffff; text-decoration: none; display: inline-flex; align-items: center; gap: 5px;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='#ffffff'">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                                    </svg>
                                    GitHub Repo
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(item.LiveDemoUrl))
                            {
                                <a href="@item.LiveDemoUrl" target="_blank" style="color: var(--accent-cyan); text-decoration: none; display: inline-flex; align-items: center; gap: 5px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="2" y1="12" x2="22" y2="12"></line>
                                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                    </svg>
                                    Live Demo
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Bottom Action / Feedback Row -->
                    @if (item.Status == VerificationStatus.Approved)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 8px; padding: 10px 14px;">
                            <div style="display: flex; align-items: center; gap: 8px; color: var(--accent-emerald); font-size: 0.82rem; font-weight: 700;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Verified & Endorsed by Dr. Michael Soli on @item.VerifiedAt?.ToString("MMM dd, yyyy")
                            </div>
                            <span style="font-size: 0.75rem; color: var(--accent-emerald); font-weight: 600;">Credential Active</span>
                        </div>
                    }
                    else if (item.Status == VerificationStatus.NeedsRevision)
                    {
                        <div style="background: rgba(244, 63, 94, 0.08); border: 1px solid rgba(244, 63, 94, 0.25); border-radius: 8px; padding: 10px 14px;">
                            <div style="font-size: 0.78rem; font-weight: 700; color: var(--accent-rose); margin-bottom: 2px;">Your Revision Note to Student:</div>
                            <div style="font-size: 0.82rem; color: #fca5a5; font-style: italic;">"@item.Feedback"</div>
                        </div>
                    }
                    else
                    {
                        <div style="display: flex; justify-content: flex-end;">
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Small"
                                       OnClick="() => OpenReviewModal(item)"
                                       Style="background: var(--accent); color: #ffffff; text-transform: none; border-radius: 8px; font-weight: 700; font-size: 0.82rem; padding: 6px 18px;">
                                Review
                            </MudButton>
                        </div>
                    }

                </div>
            }
        </div>
    }

</div>

<!-- ── Review Modal ──────────────────────────────────────────────────────── -->
@if (_modalOpen && _reviewing is not null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.65); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 16px;" @onclick="CloseModal">
        <div class="vg-card" style="width: 100%; max-width: 560px; border-radius: 14px; padding: 28px; display: flex; flex-direction: column; gap: 20px;" @onclick:stopPropagation="true">

            <!-- Modal Header -->
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="font-size: 1.1rem; font-weight: 800; color: #ffffff;">Review Submission</div>
                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 2px;">@_reviewing.StudentName &mdash; @_reviewing.Title</div>
                </div>
                <button type="button" @onclick="CloseModal" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 0;">&times;</button>
            </div>

            <!-- Student Profile Row -->
            <div style="display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); border-radius: 10px; padding: 12px;">
                <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(99,102,241,0.15); border: 1px solid rgba(99,102,241,0.3); color: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.9rem; flex-shrink: 0;">
                    @GetInitial(_reviewing.StudentName)
                </div>
                <div>
                    <div style="font-size: 0.88rem; font-weight: 700; color: #ffffff;">@_reviewing.StudentName</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">@_reviewing.Program &mdash; @_reviewing.Institution</div>
                    <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 1px;">Submitted @_reviewing.SubmittedAt.ToString("MMM dd, yyyy")</div>
                </div>
            </div>

            <!-- Links & Documents -->
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">Project Links & Documents</div>
                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                    @if (!string.IsNullOrEmpty(_reviewing.RepoUrl))
                    {
                        <a href="@_reviewing.RepoUrl" target="_blank"
                           style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 600; color: #ffffff; background: rgba(255,255,255,0.05); border: 1px solid var(--border-subtle); border-radius: 7px; padding: 6px 12px; text-decoration: none;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                            </svg>
                            GitHub Repo
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(_reviewing.LiveDemoUrl))
                    {
                        <a href="@_reviewing.LiveDemoUrl" target="_blank"
                           style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 600; color: var(--accent-cyan); background: rgba(6,182,212,0.07); border: 1px solid rgba(6,182,212,0.25); border-radius: 7px; padding: 6px 12px; text-decoration: none;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                            </svg>
                            Live Demo
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(_reviewing.DocumentUrl))
                    {
                        <a href="@_reviewing.DocumentUrl" target="_blank"
                           style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 600; color: var(--accent-gold); background: rgba(245,158,11,0.07); border: 1px solid rgba(245,158,11,0.25); border-radius: 7px; padding: 6px 12px; text-decoration: none;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            Document
                        </a>
                    }
                    @if (string.IsNullOrEmpty(_reviewing.RepoUrl) && string.IsNullOrEmpty(_reviewing.LiveDemoUrl) && string.IsNullOrEmpty(_reviewing.DocumentUrl))
                    {
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-style: italic;">No links attached.</span>
                    }
                </div>
            </div>

            <!-- Radio Toggle: Approve / Reject -->
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">Decision</div>
                <div style="display: flex; gap: 10px;">
                    <label style="@_approveLabelStyle">
                        <input type="radio" name="decision" checked="@_approveSelected" @onchange="() => _approveSelected = true" style="accent-color: var(--accent-emerald);" />
                        <span style="@_approveTextStyle">Approve</span>
                    </label>
                    <label style="@_rejectLabelStyle">
                        <input type="radio" name="decision" checked="@(!_approveSelected)" @onchange="() => _approveSelected = false" style="accent-color: var(--accent-rose);" />
                        <span style="@_rejectTextStyle">Reject / Request Changes</span>
                    </label>
                </div>
            </div>

            <!-- Lecturer Comments -->
            <div style="display: flex; flex-direction: column; gap: 6px;">
                <label style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">Lecturer Comments</label>
                <textarea @bind="_comment"
                          rows="4"
                          placeholder="@_commentPlaceholder"
                          style="width: 100%; background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); border-radius: 8px; color: #ffffff; font-size: 0.85rem; padding: 10px 12px; resize: vertical; font-family: inherit; box-sizing: border-box; outline: none;"></textarea>
            </div>

            <!-- Submit -->
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <MudButton Variant="Variant.Text" OnClick="CloseModal"
                           Style="text-transform: none; color: var(--text-secondary); font-size: 0.85rem;">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" OnClick="SubmitReview" Style="@_submitBtnStyle">
                    @(_approveSelected ? "✓ Submit Endorsement" : "Submit Revision Request")
                </MudButton>
            </div>

        </div>
    </div>
}

