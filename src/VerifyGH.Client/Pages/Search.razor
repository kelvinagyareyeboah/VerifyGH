@page "/search"

<PageTitle>Search Talent — VerifyGH</PageTitle>

<div style="display: flex; flex-direction: column; gap: 24px;">
    <div>
        <div class="vg-pill vg-pill-secondary" style="margin-bottom: 12px;">Employer Portal</div>
        <h1 class="vg-gradient-text" style="font-size: 1.8rem; font-weight: 800; margin: 0 0 6px 0;">Search Verified Talent</h1>
        <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">Filter and discover graduates by accredited skills, degree, and institution.</p>
    </div>

    <!-- Linear-style Placeholder Box -->
    <div class="vg-placeholder">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(0, 230, 118, 0.1); border: 1px solid rgba(0, 230, 118, 0.25); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0 0 8px 0; color: #ffffff;">Talent Search & Filtering Interface</h3>
        <p style="color: var(--text-secondary); max-width: 480px; margin: 0 auto 20px auto; font-size: 0.88rem; line-height: 1.5;">
            Dynamic search input, skill filter chips (C#, React, SQL), institution selector, and verified graduate profile cards.
        </p>
        <span class="vg-pill">Assigned to: Opuni Frimpong Asante (Frontend)</span>
    </div>
</div>
