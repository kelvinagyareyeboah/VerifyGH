@page "/projects/upload"

<PageTitle>Upload Project — VerifyGH</PageTitle>

<div style="display: flex; flex-direction: column; gap: 24px;">
    <div>
        <div class="vg-pill vg-pill-secondary" style="margin-bottom: 12px;">Student Portal</div>
        <h1 class="vg-gradient-text" style="font-size: 1.8rem; font-weight: 800; margin: 0 0 6px 0;">Upload Project / Credential</h1>
        <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">Submit capstone projects, repositories, and skill proofs for lecturer endorsement.</p>
    </div>

    <!-- Linear-style Placeholder Box -->
    <div class="vg-placeholder">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(0, 230, 118, 0.1); border: 1px solid rgba(0, 230, 118, 0.25); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0 0 8px 0; color: #ffffff;">Project Submission Form</h3>
        <p style="color: var(--text-secondary); max-width: 480px; margin: 0 auto 20px auto; font-size: 0.88rem; line-height: 1.5;">
            Input fields for project title, description, GitHub repository URL, live demo link, supervisor lecturer selector, and skill tags.
        </p>
        <span class="vg-pill">Assigned to: Frank Bless Kofi Tsetse (Frontend)</span>
    </div>
</div>
