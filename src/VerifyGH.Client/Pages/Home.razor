@page "/"
@layout PublicLayout
@inject NavigationManager Navigation
@inject UserSessionService Session

<PageTitle>VerifyGH — Verified Credential & Portfolio Platform</PageTitle>

<div style="max-width: 1140px; margin: 0 auto; padding: 20px 24px 80px 24px; background: #ffffff;">

    <!-- HERO SECTION -->
    <section style="padding: 80px 0 60px 0; text-align: left; max-width: 860px;">
        
        <div style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #92400e; background: #fef3c7; border: 1px solid #fde68a; padding: 6px 12px; border-radius: 6px; margin-bottom: 24px;">
            <span>●</span>
            University of Ghana · DCIT 318
        </div>

        <h1 style="font-size: 3.4rem; font-weight: 800; color: #09090b; letter-spacing: -0.04em; margin: 0 0 20px 0; line-height: 1.1;">
            Verified proof of work for Ghanaian graduates.
        </h1>

        <p style="color: #52525b; font-size: 1.15rem; line-height: 1.6; margin: 0 0 36px 0; max-width: 720px;">
            Over 300,000 students graduate annually in Ghana, but employers struggle to verify real skills. VerifyGH replaces unverified resumes with faculty-endorsed capstones, real code repositories, and verifiable credentials.
        </p>

        <div style="display: flex; gap: 14px; flex-wrap: wrap;">
            <a href="login" 
               style="background: #09090b; color: #ffffff; font-weight: 700; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-size: 0.92rem; display: inline-flex; align-items: center; gap: 8px; transition: opacity 0.15s ease;"
               onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                Open Portal / Sign In →
            </a>
            <a href="#portals" 
               style="background: #ffffff; color: #09090b; border: 1px solid #e5e5e5; font-weight: 600; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-size: 0.92rem; display: inline-flex; align-items: center; gap: 8px; transition: border-color 0.15s ease;"
               onmouseover="this.style.borderColor='#09090b'" onmouseout="this.style.borderColor='#e5e5e5'">
                Choose Your Role
            </a>
        </div>

    </section>

    <!-- METRICS STRIP -->
    <section style="border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5; padding: 36px 0; margin-bottom: 70px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px;">
            <div>
                <div style="font-size: 2.2rem; font-weight: 800; color: #09090b; letter-spacing: -0.03em;">~300,000</div>
                <div style="color: #71717a; font-size: 0.85rem; font-weight: 600; margin-top: 4px;">Annual Tertiary Graduates</div>
            </div>
            <div>
                <div style="font-size: 2.2rem; font-weight: 800; color: #92400e; letter-spacing: -0.03em;">100%</div>
                <div style="color: #71717a; font-size: 0.85rem; font-weight: 600; margin-top: 4px;">Faculty Verified Code</div>
            </div>
            <div>
                <div style="font-size: 2.2rem; font-weight: 800; color: #09090b; letter-spacing: -0.03em;">Zero</div>
                <div style="color: #71717a; font-size: 0.85rem; font-weight: 600; margin-top: 4px;">Resume Exaggeration</div>
            </div>
            <div>
                <div style="font-size: 2.2rem; font-weight: 800; color: #09090b; letter-spacing: -0.03em;">Real-Time</div>
                <div style="color: #71717a; font-size: 0.85rem; font-weight: 600; margin-top: 4px;">SignalR Endorsement Alerts</div>
            </div>
        </div>
    </section>

    <!-- PORTALS SECTION (ROLE SELECTION) -->
    <section id="portals" style="margin-bottom: 80px;">
        <div style="margin-bottom: 32px;">
            <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; color: #92400e; letter-spacing: 0.08em; margin-bottom: 6px;">
                Platform Access
            </div>
            <h2 style="font-size: 1.8rem; font-weight: 800; color: #09090b; margin: 0; letter-spacing: -0.02em;">
                Select your portal to enter
            </h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
            
            <!-- Student Portal -->
            <div class="vg-card" style="display: flex; flex-direction: column; justify-content: space-between; border-left: 4px solid #b45309; background: #ffffff;">
                <div>
                    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: #92400e; letter-spacing: 0.06em; margin-bottom: 8px;">
                        Student Gateway
                    </div>
                    <h3 style="font-size: 1.3rem; font-weight: 700; color: #09090b; margin: 0 0 10px 0;">
                        Student Portfolio
                    </h3>
                    <p style="color: #52525b; font-size: 0.9rem; line-height: 1.55; margin: 0 0 24px 0;">
                        Upload capstone projects, attach GitHub links and documentation, request supervisor endorsement, and track verification status.
                    </p>
                </div>
                <button type="button" 
                        @onclick='() => SelectRole(UserRole.Student, "projects/my")'
                        style="width: 100%; background: #09090b; color: #ffffff; font-weight: 700; padding: 10px; border-radius: 6px; border: none; cursor: pointer; font-size: 0.88rem; transition: opacity 0.15s ease;"
                        onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                    Enter as Student →
                </button>
            </div>

            <!-- Lecturer Portal -->
            <div class="vg-card" style="display: flex; flex-direction: column; justify-content: space-between; border-left: 4px solid #78350f; background: #ffffff;">
                <div>
                    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: #92400e; letter-spacing: 0.06em; margin-bottom: 8px;">
                        Faculty Gateway
                    </div>
                    <h3 style="font-size: 1.3rem; font-weight: 700; color: #09090b; margin: 0 0 10px 0;">
                        Lecturer Review Queue
                    </h3>
                    <p style="color: #52525b; font-size: 0.9rem; line-height: 1.55; margin: 0 0 24px 0;">
                        Access student deliverables from your department, examine code repositories, provide academic feedback, and certify credentials.
                    </p>
                </div>
                <button type="button" 
                        @onclick='() => SelectRole(UserRole.Lecturer, "verification")'
                        style="width: 100%; background: #fafaf9; color: #09090b; font-weight: 700; padding: 10px; border-radius: 6px; border: 1px solid #e5e5e5; cursor: pointer; font-size: 0.88rem; transition: all 0.15s ease;"
                        onmouseover="this.style.borderColor='#09090b'" onmouseout="this.style.borderColor='#e5e5e5'">
                    Enter Review Queue →
                </button>
            </div>

            <!-- Employer Portal -->
            <div class="vg-card" style="display: flex; flex-direction: column; justify-content: space-between; border-left: 4px solid #a1a1aa; background: #ffffff;">
                <div>
                    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: #71717a; letter-spacing: 0.06em; margin-bottom: 8px;">
                        Industry Gateway
                    </div>
                    <h3 style="font-size: 1.3rem; font-weight: 700; color: #09090b; margin: 0 0 10px 0;">
                        Employer Search
                    </h3>
                    <p style="color: #52525b; font-size: 0.9rem; line-height: 1.55; margin: 0 0 24px 0;">
                        Search vetted Ghanaian graduates by verified skills and degree programs. Review genuine code before scheduling interviews.
                    </p>
                </div>
                <button type="button" 
                        @onclick='() => SelectRole(UserRole.Employer, "search")'
                        style="width: 100%; background: #fafaf9; color: #09090b; font-weight: 700; padding: 10px; border-radius: 6px; border: 1px solid #e5e5e5; cursor: pointer; font-size: 0.88rem; transition: all 0.15s ease;"
                        onmouseover="this.style.borderColor='#09090b'" onmouseout="this.style.borderColor='#e5e5e5'">
                    Browse Talent →
                </button>
            </div>

        </div>
    </section>

    <!-- HOW IT WORKS (SIMPLE 3 STEPS) -->
    <section id="how-it-works" style="margin-bottom: 70px;">
        <div style="margin-bottom: 32px;">
            <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; color: #92400e; letter-spacing: 0.08em; margin-bottom: 6px;">
                Architecture
            </div>
            <h2 style="font-size: 1.8rem; font-weight: 800; color: #09090b; margin: 0; letter-spacing: -0.02em;">
                The 3-Step Verification Pipeline
            </h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
            <div class="vg-card" style="padding: 24px; background: #ffffff;">
                <div style="font-size: 1.5rem; font-weight: 800; color: #92400e; margin-bottom: 8px;">01</div>
                <h4 style="font-size: 1.05rem; font-weight: 700; color: #09090b; margin: 0 0 6px 0;">Student Submits Work</h4>
                <p style="color: #52525b; font-size: 0.85rem; line-height: 1.55; margin: 0;">
                    Uploads project deliverables, GitHub repository link, and live demo. Selects supervising lecturer.
                </p>
            </div>

            <div class="vg-card" style="padding: 24px; background: #ffffff;">
                <div style="font-size: 1.5rem; font-weight: 800; color: #92400e; margin-bottom: 8px;">02</div>
                <h4 style="font-size: 1.05rem; font-weight: 700; color: #09090b; margin: 0 0 6px 0;">Supervisor Endorses</h4>
                <p style="color: #52525b; font-size: 0.85rem; line-height: 1.55; margin: 0;">
                    Department lecturer inspects code quality, leaves academic feedback, and officially approves the credential.
                </p>
            </div>

            <div class="vg-card" style="padding: 24px; background: #ffffff;">
                <div style="font-size: 1.5rem; font-weight: 800; color: #92400e; margin-bottom: 8px;">03</div>
                <h4 style="font-size: 1.05rem; font-weight: 700; color: #09090b; margin: 0 0 6px 0;">Employer Recruits</h4>
                <p style="color: #52525b; font-size: 0.85rem; line-height: 1.55; margin: 0;">
                    Companies search verified graduates with confirmed proof-of-work rather than unverified resumes.
                </p>
            </div>
        </div>
    </section>

</div>

@code {
    private void SelectRole(UserRole role, string redirectUrl)
    {
        Session.SwitchRole(role);
        Navigation.NavigateTo(redirectUrl);
    }
}
