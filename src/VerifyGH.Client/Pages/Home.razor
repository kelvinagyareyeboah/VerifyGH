@page "/"
@layout PublicLayout
@inject NavigationManager Navigation
@inject UserSessionService Session

<PageTitle>VerifyGH — Verified Proof of Work for Ghanaian Graduates</PageTitle>

<div class="landing-page">

    <!-- ════════════════════════════════════════════════════════════
         HERO SECTION
    ════════════════════════════════════════════════════════════ -->
    <section class="hero-section">
        <div class="hero-grid">

            <!-- Left: Hero Text -->
            <div class="hero-content">
                <div class="hero-badge">
                    <span class="hero-badge-dot"></span>
                    <span>University of Ghana · DCIT 318 Capstone</span>
                </div>

                <h1 class="hero-title">
                    Verified proof of work<br/>
                    <span class="highlight-blue">for every graduate.</span>
                </h1>

                <p class="hero-desc">
                    Ghana produces over 300,000 graduates a year. VerifyGH lets students prove their skills with faculty-endorsed projects — and lets employers hire with genuine confidence.
                </p>

                <div class="hero-actions">
                    <a href="login" class="btn-primary">
                        Enter Portal →
                    </a>
                    <a href="#how" class="btn-secondary">
                        How It Works
                    </a>
                </div>

                <!-- Social Proof -->
                <div class="hero-social">
                    <div class="avatar-stack">
                        <div class="avatar" style="background:#2a7fba;">K</div>
                        <div class="avatar" style="background:#0284c7;">A</div>
                        <div class="avatar" style="background:#38bdf8;">E</div>
                        <div class="avatar" style="background:#7dd3fc;">F</div>
                    </div>
                    <span class="social-text">
                        Supervised by <strong>Dr. Michael Soli</strong> &amp; <strong>Dr. Isaac Wiafe</strong>
                    </span>
                </div>
            </div>

            <!-- Right: Interactive Dashboard Card Preview -->
            <div class="hero-preview-wrapper">
                <div class="hero-preview-card">
                    <div class="preview-header">
                        <div class="preview-header-left">
                            <span class="preview-title">Recent Submissions</span>
                            <span class="preview-live-badge">● Live Sync</span>
                        </div>
                        <span class="preview-date">UG Computer Science</span>
                    </div>

                    <div class="preview-list">
                        <div class="preview-item">
                            <div class="preview-item-info">
                                <div class="item-title">Blockchain Transcript System</div>
                                <div class="item-sub">Kelvin Agyare Yeboah · Soli Lab</div>
                            </div>
                            <span class="badge-approved">Approved</span>
                        </div>

                        <div class="preview-item">
                            <div class="preview-item-info">
                                <div class="item-title">AI Lecture Scheduler</div>
                                <div class="item-sub">Abena Mensah · Legon CS</div>
                            </div>
                            <span class="badge-pending">Pending</span>
                        </div>

                        <div class="preview-item">
                            <div class="preview-item-info">
                                <div class="item-title">Campus Bus Tracker</div>
                                <div class="item-sub">Kofi Asante · KNUST</div>
                            </div>
                            <span class="badge-reviewing">Reviewing</span>
                        </div>
                    </div>

                    <div class="signalr-pill">
                        <span class="signalr-dot"></span>
                        <span class="signalr-text">SignalR: Project #12 verified by Dr. Soli</span>
                    </div>
                </div>

                <!-- Floating endorsement chip -->
                <div class="floating-chip">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2a7fba" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    <span>Faculty Endorsed</span>
                </div>
            </div>

        </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         STATS BAND
    ════════════════════════════════════════════════════════════ -->
    <section class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">300,000+</div>
                <div class="stat-label">Ghanaian graduates per year</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">100%</div>
                <div class="stat-label">Faculty-verified projects</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">0</div>
                <div class="stat-label">Resume exaggerations</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">Real-Time</div>
                <div class="stat-label">Live SignalR endorsements</div>
            </div>
        </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         THE PROBLEM
    ════════════════════════════════════════════════════════════ -->
    <section class="content-section">
        <div class="section-header">
            <div class="lp-label">The Problem</div>
            <h2 class="section-title">Employers can't trust what they can't verify.</h2>
            <p class="section-desc">
                A traditional CV lists skills — but nothing proves they are authentic. VerifyGH anchors student credentials to actual code reviewed by university faculty.
            </p>
        </div>

        <div class="grid-3">
            <div class="problem-card">
                <div class="card-icon">🎓</div>
                <h3 class="card-title">Unverified Resumes</h3>
                <p class="card-body">Graduates self-report technical skills with no third-party proof, making candidate screening unreliable and biased.</p>
            </div>
            <div class="problem-card">
                <div class="card-icon">🔍</div>
                <h3 class="card-title">Slow Background Checks</h3>
                <p class="card-body">HR teams and recruiters spend days contacting academic registrars with no instant, standardized verification pipeline.</p>
            </div>
            <div class="problem-card">
                <div class="card-icon">🚫</div>
                <h3 class="card-title">Lost Local Talent</h3>
                <p class="card-body">Exceptional student developers who build great solutions get overlooked if they lack industry connections.</p>
            </div>
        </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         FEATURES
    ════════════════════════════════════════════════════════════ -->
    <section id="features" class="features-section">
        <div class="features-container">
            <div class="section-header text-center">
                <div class="lp-label">Core Capabilities</div>
                <h2 class="section-title">Everything you need. Nothing you don't.</h2>
                <p class="section-desc mx-auto">Built to be clean, responsive, and authentically verifiable for Ghana's tech ecosystem.</p>
            </div>

            <div class="grid-3">
                <div class="feature-card">
                    <div class="feature-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2a7fba" stroke-width="2.2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <h3 class="card-title">Faculty Endorsement</h3>
                    <p class="card-body">Accredited university supervisors review code, approve capstones, and add academic feedback to audit logs.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2a7fba" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                    </div>
                    <h3 class="card-title">Real Code Repositories</h3>
                    <p class="card-body">Submissions link directly to GitHub repos and live deployments — no more unverifiable paper certificates.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2a7fba" stroke-width="2.2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    </div>
                    <h3 class="card-title">Instant SignalR Alerts</h3>
                    <p class="card-body">Receive live real-time notifications when your supervisor approves, comments, or requests changes on your capstone.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2a7fba" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </div>
                    <h3 class="card-title">Employer Search</h3>
                    <p class="card-body">Filter verified Ghanaian graduates by programming language, framework, institution, and verification level.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2a7fba" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                    </div>
                    <h3 class="card-title">Digital Credentials</h3>
                    <p class="card-body">Shareable verified badge cards with cryptographic project IDs and QR codes for effortless CV verification.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2a7fba" stroke-width="2.2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
                    </div>
                    <h3 class="card-title">Role-Based Access</h3>
                    <p class="card-body">Dedicated workspaces for Students, Lecturers, and Employers designed around their specific daily workflows.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         HOW IT WORKS
    ════════════════════════════════════════════════════════════ -->
    <section id="how" class="content-section">
        <div class="section-header text-center">
            <div class="lp-label">Workflow</div>
            <h2 class="section-title">From submission to hire in 3 steps.</h2>
            <p class="section-desc mx-auto">A transparent review pipeline directly connected to university faculty.</p>
        </div>

        <div class="steps-wrapper">
            <div class="steps-connector"></div>
            <div class="steps-grid">
                <div class="step-card">
                    <div class="step-number">01</div>
                    <h3 class="step-title">Student Submits</h3>
                    <p class="step-desc">Upload your capstone: title, description, GitHub repo, live demo link, skills, and choose your supervisor.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">02</div>
                    <h3 class="step-title">Lecturer Endorses</h3>
                    <p class="step-desc">Your lecturer reviews the repository, provides academic feedback, and stamps the credential on-chain.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">03</div>
                    <h3 class="step-title">Employer Recruits</h3>
                    <p class="step-desc">Recruiters discover verified developers by confirmed skills and inspect real working code before interviews.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         PORTALS SECTION
    ════════════════════════════════════════════════════════════ -->
    <section id="portals" class="portals-section">
        <div class="portals-container">
            <div class="section-header text-center">
                <div class="lp-label lp-label-dark">Access Portals</div>
                <h2 class="section-title text-white">Choose your workspace.</h2>
                <p class="section-desc text-muted mx-auto">Each role has a tailored interface built specifically for their verification tasks.</p>
            </div>

            <div class="grid-3">
                <!-- Student Portal -->
                <div class="portal-card">
                    <div>
                        <div class="portal-icon-box" style="background:#fef3c7; color:#b45309;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                        </div>
                        <div class="portal-tag" style="color:#f59e0b;">Student Gateway</div>
                        <h3 class="portal-title">Student Workspace</h3>
                        <p class="portal-desc">Upload projects, link your GitHub repos, select supervisors, and track verification in real time.</p>
                    </div>
                    <button type="button" class="btn-portal" @onclick='() => SelectRole(UserRole.Student, "projects/my")'>
                        Enter as Student →
                    </button>
                </div>

                <!-- Lecturer Portal (Highlighted Sea Blue) -->
                <div class="portal-card portal-card-active">
                    <div>
                        <div class="portal-icon-box" style="background:rgba(255,255,255,0.2); color:#fff;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <div class="portal-tag" style="color:rgba(255,255,255,0.85);">Faculty Review</div>
                        <h3 class="portal-title text-white">Lecturer Queue</h3>
                        <p class="portal-desc" style="color:rgba(255,255,255,0.88);">Review submitted capstones, examine repositories, provide guidance, and sign off verified badges.</p>
                    </div>
                    <button type="button" class="btn-portal-active" @onclick='() => SelectRole(UserRole.Lecturer, "verification")'>
                        Enter Review Queue →
                    </button>
                </div>

                <!-- Employer Portal -->
                <div class="portal-card">
                    <div>
                        <div class="portal-icon-box" style="background:#e0f2fe; color:#2a7fba;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        </div>
                        <div class="portal-tag" style="color:#38bdf8;">Industry Gateway</div>
                        <h3 class="portal-title">Employer Search</h3>
                        <p class="portal-desc">Search verified talent across Ghanaian universities. Review authentic code repositories before scheduling interviews.</p>
                    </div>
                    <button type="button" class="btn-portal" @onclick='() => SelectRole(UserRole.Employer, "search")'>
                        Browse Talent →
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         FAQ
    ════════════════════════════════════════════════════════════ -->
    <section id="faq" class="faq-section">
        <div class="section-header text-center">
            <div class="lp-label">Frequently Asked</div>
            <h2 class="section-title">Common questions.</h2>
        </div>

        <div class="faq-list">
            @foreach (var (q, a) in Faqs)
            {
                <details class="faq-item">
                    <summary class="faq-summary">
                        <span>@q</span>
                        <svg class="faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.2"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <p class="faq-answer">@a</p>
                </details>
            }
        </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         CTA BANNER
    ════════════════════════════════════════════════════════════ -->
    <section class="cta-section">
        <div class="cta-box">
            <div class="cta-text">
                <h2 class="cta-title">Ready to verify your work?</h2>
                <p class="cta-desc">Join graduates building trustworthy, faculty-endorsed portfolios for Ghana's tech market.</p>
            </div>
            <div class="cta-buttons">
                <a href="register" class="btn-primary">
                    Create Account →
                </a>
                <a href="login" class="btn-secondary-dark">
                    Sign In
                </a>
            </div>
        </div>
    </section>

</div>

<style>
    /* Global Landing Layout */
    .landing-page {
        overflow-x: hidden;
        background-color: #faf8f4;
        color: #1e293b;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    /* Common Labels & Headings */
    .lp-label {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #2a7fba;
        background: #f0f7fc;
        border: 1px solid #d0e4f5;
        border-radius: 999px;
        padding: 5px 14px;
        margin-bottom: 12px;
    }
    .lp-label-dark {
        background: #1e293b;
        border-color: #334155;
        color: #93c5fd;
    }

    .section-header {
        margin-bottom: 40px;
    }
    .section-header.text-center {
        text-align: center;
    }
    .section-title {
        font-size: 2.2rem;
        font-weight: 900;
        color: #0f172a;
        letter-spacing: -0.035em;
        line-height: 1.2;
        margin: 10px 0 14px;
    }
    .section-desc {
        font-size: 0.96rem;
        color: #64748b;
        line-height: 1.65;
        max-width: 600px;
        margin: 0;
    }
    .mx-auto {
        margin-left: auto;
        margin-right: auto;
    }

    /* Hero Section */
    .hero-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 64px 24px 56px;
        box-sizing: border-box;
    }
    .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 52px;
        align-items: center;
    }
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f0f7fc;
        border: 1px solid #d0e4f5;
        border-radius: 999px;
        padding: 5px 14px 5px 10px;
        font-size: 0.8rem;
        font-weight: 700;
        color: #2a7fba;
        margin-bottom: 22px;
    }
    .hero-badge-dot {
        background: #2a7fba;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }
    .hero-title {
        font-size: 3.1rem;
        font-weight: 900;
        color: #0f172a;
        letter-spacing: -0.04em;
        line-height: 1.12;
        margin: 0 0 20px;
    }
    .highlight-blue {
        color: #2a7fba;
    }
    .hero-desc {
        font-size: 1.05rem;
        color: #475569;
        line-height: 1.7;
        margin: 0 0 32px;
        max-width: 500px;
    }
    .hero-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        align-items: center;
    }

    /* Buttons */
    .btn-primary {
        background: #2a7fba;
        color: #ffffff;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.94rem;
        padding: 12px 24px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        transition: background 0.15s ease, transform 0.1s ease;
    }
    .btn-primary:hover {
        background: #236fa5;
        color: #ffffff;
        transform: translateY(-1px);
    }
    .btn-secondary {
        background: #ffffff;
        color: #1e293b;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.94rem;
        padding: 12px 22px;
        border-radius: 9px;
        border: 1px solid #e2e8f0;
        transition: border-color 0.15s ease;
    }
    .btn-secondary:hover {
        border-color: #94a3b8;
        color: #0f172a;
    }
    .btn-secondary-dark {
        background: #1e293b;
        color: #f1f5f9;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.94rem;
        padding: 12px 22px;
        border-radius: 9px;
        border: 1px solid #334155;
    }
    .btn-secondary-dark:hover {
        background: #334155;
        color: #ffffff;
    }

    /* Hero Social */
    .hero-social {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 36px;
    }
    .avatar-stack {
        display: flex;
    }
    .avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid #ffffff;
        margin-left: -7px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 800;
        color: #ffffff;
        flex-shrink: 0;
    }
    .avatar:first-child {
        margin-left: 0;
    }
    .social-text {
        font-size: 0.84rem;
        color: #64748b;
        font-weight: 500;
    }

    /* Hero Preview Card */
    .hero-preview-wrapper {
        position: relative;
    }
    .hero-preview-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 16px 40px rgba(42, 127, 186, 0.08);
    }
    .preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #f1f5f9;
    }
    .preview-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .preview-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #0f172a;
    }
    .preview-live-badge {
        font-size: 0.72rem;
        color: #2a7fba;
        font-weight: 700;
        background: #f0f7fc;
        padding: 3px 10px;
        border-radius: 999px;
    }
    .preview-date {
        font-size: 0.72rem;
        color: #94a3b8;
    }
    .preview-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .preview-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 11px 14px;
        background: #faf8f4;
        border-radius: 10px;
        border: 1px solid #f0ece3;
    }
    .item-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #0f172a;
    }
    .item-sub {
        font-size: 0.75rem;
        color: #64748b;
        margin-top: 2px;
    }
    .badge-approved {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #059669;
        white-space: nowrap;
    }
    .badge-pending {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
        background: #fef9f0;
        color: #b45309;
        white-space: nowrap;
    }
    .badge-reviewing {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
        background: #f0f7fc;
        color: #2a7fba;
        white-space: nowrap;
    }
    .signalr-pill {
        margin-top: 14px;
        background: #0f172a;
        border-radius: 9px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .signalr-dot {
        width: 7px;
        height: 7px;
        background: #38bdf8;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }
    .signalr-text {
        font-size: 0.78rem;
        color: #cbd5e1;
    }
    .floating-chip {
        position: absolute;
        top: -12px;
        right: -12px;
        background: #ffffff;
