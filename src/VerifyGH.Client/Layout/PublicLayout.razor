@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject UserSessionService Session

<MudThemeProvider IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="public-layout-root">

    <!-- ── NAVBAR ── -->
    <header class="public-navbar">
        <div class="public-navbar-container">

            <!-- Brand -->
            <a href="" class="brand-link">
                <div class="brand-icon-box">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <span class="brand-text">VerifyGH</span>
            </a>

            <!-- Links (Hidden on Mobile) -->
            <nav class="public-nav-links">
                <a href="#features" class="lp-nav-link">Features</a>
                <a href="#how" class="lp-nav-link">How It Works</a>
                <a href="#portals" class="lp-nav-link">Portals</a>
                <a href="#faq" class="lp-nav-link">FAQ</a>
            </nav>

            <!-- CTAs -->
            <div class="public-nav-ctas">
                <a href="login" class="lp-btn-ghost">Sign In</a>
                <a href="register" class="lp-btn-solid">Get Started →</a>
            </div>
        </div>
    </header>

    <!-- Page body -->
    <main style="flex:1;">
        @Body
    </main>

    <!-- ── FOOTER ── -->
    <footer class="public-footer">
        <div class="footer-container">
            <div class="lp-footer-grid">

                <!-- Brand blurb -->
                <div class="footer-col-main">
                    <div class="footer-brand">
                        <div class="footer-brand-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <span class="footer-brand-title">VerifyGH</span>
                    </div>
                    <p class="footer-desc">
                        Ghana's premier faculty-endorsed capstone portfolio platform. Replacing unverified resumes with real, faculty-verified proof of work.
                    </p>
                    <div class="footer-tags">
                        <span class="tech-tag">ASP.NET Core</span>
                        <span class="tech-tag">Blazor WASM</span>
                        <span class="tech-tag">SignalR</span>
                    </div>
                </div>

                <div class="footer-col">
                    <div class="footer-col-title">Platform</div>
                    <div class="footer-links">
                        <a href="projects/my" class="lp-footer-link">Student Portal</a>
                        <a href="verification" class="lp-footer-link">Lecturer Queue</a>
                        <a href="search" class="lp-footer-link">Employer Search</a>
                        <a href="credentials" class="lp-footer-link">Credentials</a>
                    </div>
                </div>

                <div class="footer-col">
                    <div class="footer-col-title">Account</div>
                    <div class="footer-links">
                        <a href="login" class="lp-footer-link">Sign In</a>
                        <a href="register" class="lp-footer-link">Register</a>
                    </div>
                </div>

                <div class="footer-col">
                    <div class="footer-col-title">Academic</div>
                    <div class="footer-links-text">
                        <span>DCIT 318 — Semester Project</span>
                        <span>Dept. of Computer Science</span>
                        <span>University of Ghana, Legon</span>
                    </div>
                </div>

            </div>

            <div class="footer-bottom">
                <span>© 2026 VerifyGH — University of Ghana · DCIT 318</span>
                <span>Supervisors: Dr. Michael Soli &amp; Dr. Isaac Wiafe</span>
            </div>
        </div>
    </footer>

</div>

<style>
    .public-layout-root {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #faf8f4;
        color: #1e293b;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    /* Navbar */
    .public-navbar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(250, 248, 244, 0.95);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid #e7e2d6;
    }
    .public-navbar-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .brand-link {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }
    .brand-icon-box {
        width: 34px;
        height: 34px;
        background: #2a7fba;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .brand-text {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.025em;
    }
    .public-nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
    }
    .public-nav-ctas {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .lp-nav-link {
        color: #475569;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        transition: color 0.12s;
    }
    .lp-nav-link:hover {
        color: #2a7fba;
    }

    .lp-btn-ghost {
        color: #0f172a;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 600;
        padding: 7px 16px;
        border-radius: 7px;
        border: 1px solid #dcd7cc;
        background: #ffffff;
        transition: border-color 0.12s;
    }
    .lp-btn-ghost:hover {
        border-color: #94a3b8;
    }

    .lp-btn-solid {
        background: #2a7fba;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 700;
        padding: 8px 18px;
        border-radius: 7px;
        transition: background 0.12s;
    }
    .lp-btn-solid:hover {
        background: #236fa5;
        color: #ffffff;
    }

    /* Footer */
    .public-footer {
        background: #0f172a;
        color: #f8fafc;
        padding: 64px 24px 32px;
    }
    .footer-container {
        max-width: 1200px;
        margin: 0 auto;
    }
    .lp-footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.2fr;
        gap: 40px;
        padding-bottom: 40px;
        border-bottom: 1px solid #1e293b;
    }
    .footer-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }
    .footer-brand-icon {
        width: 30px;
        height: 30px;
        background: #2a7fba;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .footer-brand-title {
        font-weight: 800;
        font-size: 1.1rem;
        color: #ffffff;
    }
    .footer-desc {
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.65;
        max-width: 320px;
        margin: 0 0 18px;
    }
    .footer-tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .tech-tag {
        font-size: 0.74rem;
        color: #94a3b8;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 4px 10px;
    }
    .footer-col-title {
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #64748b;
        margin-bottom: 16px;
    }
    .footer-links, .footer-links-text {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .footer-links-text {
        color: #94a3b8;
        font-size: 0.86rem;
        line-height: 1.5;
    }
    .lp-footer-link {
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.86rem;
        transition: color 0.12s;
    }
    .lp-footer-link:hover {
        color: #38bdf8;
    }
    .footer-bottom {
        padding-top: 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 0.8rem;
        color: #64748b;
    }

    /* Mobile Responsive Header & Footer */
    @@media (max-width: 860px) {
        .public-nav-links {
            display: none !important;
        }
        .public-navbar-container {
            padding: 0 16px;
        }
        .brand-text {
            font-size: 1.05rem;
        }
        .lp-btn-ghost, .lp-btn-solid {
            padding: 6px 12px;
            font-size: 0.82rem;
        }
        .public-footer {
            padding: 44px 18px 28px;
        }
        .lp-footer-grid {
            grid-template-columns: 1fr;
            gap: 28px;
            padding-bottom: 28px;
        }
        .footer-desc {
            max-width: 100%;
        }
        .footer-bottom {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }
    }
</style>
