@inherits LayoutComponentBase
@inject UserSessionService Session
@inject NavigationManager Navigation
@inject AuthService Auth
@inject ISnackbar Snackbar
@implements IDisposable

<MudThemeProvider IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<!-- Mobile Drawer Overlay -->
<div class="drawer-overlay @(DrawerOpen ? "open" : "")" @onclick="CloseDrawer"></div>

<div class="app-shell">
    <aside class="sidebar-container @(DrawerOpen ? "open" : "")">
        <NavMenu />
    </aside>

    <div class="main-viewport">
        <header class="top-header">
            <div style="display: flex; align-items: center; gap: 12px;">
                <button class="mobile-menu-btn" @onclick="ToggleDrawer" title="Menu" type="button">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="3" y1="6"  x2="21" y2="6"/>
                        <line x1="3" y1="12" x2="21" y2="12"/>
                        <line x1="3" y1="18" x2="21" y2="18"/>
                    </svg>
                </button>
                <div class="breadcrumb">
                    <span class="breadcrumb-item">VerifyGH</span>
                    <span class="breadcrumb-sep">/</span>
                    <span class="breadcrumb-active">@GetRoleTitle(Session.CurrentRole)</span>
                </div>
            </div>

            <!-- Top Actions -->
            <div style="display: flex; align-items: center; gap: 12px;">
                <div class="header-search-box" @onclick='() => Navigation.NavigateTo("search")'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <span>Search talent, skills, projects...</span>
                </div>

                @if (Session.IsAuthenticated)
                {
                    <div class="role-chip" style="background: @GetRoleBg(Session.CurrentRole); color: @GetRoleColor(Session.CurrentRole);">
                        @Session.CurrentRole.ToString()
                    </div>
                }
                else
                {
                    <a href="login" class="login-action-btn">Sign In</a>
                }
            </div>
        </header>

        <main class="content-body">
            @Body
        </main>
    </div>

    <!-- ── Mobile Bottom Navigation Bar ── -->
    <nav class="mobile-bottom-nav">
        @if (Session.CurrentRole == UserRole.Lecturer || Session.CurrentRole == UserRole.Admin)
        {
            <a href="verification" class="bottom-nav-item @(IsActive("verification") ? "active" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <span>Queue</span>
            </a>
            <a href="projects/my" class="bottom-nav-item @(IsActive("projects/my") ? "active" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                </svg>
                <span>Projects</span>
            </a>
            <a href="search" class="bottom-nav-item @(IsActive("search") ? "active" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <span>Directory</span>
            </a>
            <a href="credentials" class="bottom-nav-item @(IsActive("credentials") ? "active" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <polyline points="9 12 11 14 15 10"/>
                </svg>
                <span>Badges</span>
            </a>
        }
        else
        {
            <a href="projects/my" class="bottom-nav-item @(IsActive("projects/my") ? "active" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                </svg>
                <span>Projects</span>
            </a>
            <a href="projects/upload" class="bottom-nav-item @(IsActive("projects/upload") ? "active" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="16"/>
                    <line x1="8" y1="12" x2="16" y2="12"/>
                </svg>
                <span>Submit</span>
            </a>
            <a href="credentials" class="bottom-nav-item @(IsActive("credentials") ? "active" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <polyline points="9 12 11 14 15 10"/>
                </svg>
                <span>Badges</span>
            </a>
            <a href="search" class="bottom-nav-item @(IsActive("search") ? "active" : "")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <span>Explore</span>
            </a>
        }
    </nav>
</div>

@code {
    private bool DrawerOpen { get; set; } = false;

    private void ToggleDrawer() => DrawerOpen = !DrawerOpen;
    private void CloseDrawer()  => DrawerOpen = false;

    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        DrawerOpen = false;
        StateHasChanged();
    }

    private bool IsActive(string path)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        return relative.Equals(path.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
               || (string.IsNullOrEmpty(relative) && path == "");
    }

    private string GetRoleTitle(UserRole role) => role switch
    {
        UserRole.Student  => "Student Portal",
        UserRole.Lecturer => "Faculty Review",
        UserRole.Admin    => "System Admin",
        UserRole.Employer => "Talent Search",
        _ => "Dashboard"
    };

    private string GetRoleColor(UserRole role) => role switch
    {
        UserRole.Student  => "#0369a1",
        UserRole.Lecturer => "#0f766e",
        UserRole.Admin    => "#7c3aed",
        UserRole.Employer => "#b45309",
        _ => "#475569"
    };

    private string GetRoleBg(UserRole role) => role switch
    {
        UserRole.Student  => "#e0f2fe",
        UserRole.Lecturer => "#ccfbf1",
        UserRole.Admin    => "#f3e8ff",
        UserRole.Employer => "#fef3c7",
        _ => "#f1f5f9"
    };

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
