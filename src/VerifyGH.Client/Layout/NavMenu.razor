@inject UserSessionService Session
@inject NavigationManager Navigation
@inject AuthService Auth
@inject ISnackbar Snackbar
@implements IDisposable

<div class="nav-container">

    <!-- Brand -->
    <a href="" class="nav-brand">
        <div class="brand-logo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <polyline points="9 12 11 14 15 10"/>
            </svg>
        </div>
        <div>
            <div class="brand-name">VerifyGH</div>
            <div class="brand-sub">University of Ghana</div>
        </div>
    </a>

    <!-- Nav Links -->
    <nav class="nav-links">

        @if (Session.CurrentRole == UserRole.Student)
        {
            <div class="nav-section-label">Student</div>
            <NavLink class="nav-item" href="projects/my" Match="NavLinkMatch.All">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                <span>My Projects</span>
                <span class="badge">4</span>
            </NavLink>
            <NavLink class="nav-item" href="projects/upload">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <span>Submit Capstone</span>
            </NavLink>
            <NavLink class="nav-item" href="credentials">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                <span>Verified Badges</span>
                <span class="badge green">3</span>
            </NavLink>
        }
        else if (Session.CurrentRole == UserRole.Lecturer)
        {
            <div class="nav-section-label">Faculty</div>
            <NavLink class="nav-item" href="verification" Match="NavLinkMatch.All">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span>Review Queue</span>
            </NavLink>
            <NavLink class="nav-item" href="search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span>Talent Directory</span>
            </NavLink>
        }
        else if (Session.CurrentRole == UserRole.Admin)
        {
            <div class="nav-section-label">System Admin</div>
            <NavLink class="nav-item" href="verification" Match="NavLinkMatch.All">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span>Review Queue</span>
            </NavLink>
            <NavLink class="nav-item" href="projects/my">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                <span>All Submissions</span>
            </NavLink>
            <NavLink class="nav-item" href="search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span>Talent Directory</span>
            </NavLink>
        }
        else if (Session.CurrentRole == UserRole.Employer)
        {
            <div class="nav-section-label">Recruiter</div>
            <NavLink class="nav-item" href="search" Match="NavLinkMatch.All">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span>Search Talent</span>
            </NavLink>
            <NavLink class="nav-item" href="credentials">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                <span>Verify Credentials</span>
            </NavLink>
        }

        <div class="nav-section-label">General</div>
        <a class="nav-item" href="">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>Home</span>
        </a>
        <NavLink class="nav-item" href="search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Explore</span>
        </NavLink>

    </nav>

    <!-- User Footer -->
    <div class="nav-footer">
        @if (Session.IsAuthenticated)
        {
            <div class="user-avatar">@GetInitial(Session.CurrentSession.Name)</div>
            <div class="user-meta">
                <div class="user-name">@Session.CurrentSession.Name</div>
                <div class="user-role">@Session.CurrentSession.Role.ToString()</div>
            </div>
            <button class="logout-btn" @onclick="HandleSignOut" title="Sign out">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </button>
        }
        else
        {
            <a href="login" class="sign-in-btn">Sign In</a>
        }
    </div>

</div>

@code {
    protected override void OnInitialized() => Session.OnChange += StateHasChanged;

    private async Task HandleSignOut()
    {
        await Auth.LogoutAsync();
        Snackbar.Add("Signed out.", Severity.Info);
        Navigation.NavigateTo("login");
    }

    private string GetInitial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "U" : name[0].ToString().ToUpper();

    public void Dispose() => Session.OnChange -= StateHasChanged;
}
